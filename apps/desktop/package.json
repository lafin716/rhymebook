{
  "name": "@branch/desktop",
  "version": "0.18.0",
  "private": true,
  "description": "rhymebook 데스크톱 (Electron + 내장 bridge)",
  "main": "dist/main.cjs",
  "scripts": {
    "build:main": "node build.mjs",
    "build:renderer": "pnpm --filter @branch/ui exec vite build --base ./ --outDir ../../apps/desktop/dist/renderer --emptyOutDir",
    "build": "pnpm build:renderer && pnpm build:main",
    "dev": "node dev.mjs",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json",
    "package": "pnpm build && pnpm whisper && electron-builder --publish never",
    "package:dir": "pnpm build && pnpm whisper && electron-builder --dir --publish never",
    "whisper": "node scripts/build-whisper.mjs"
  },
  "devDependencies": {
    "@branch/bridge": "workspace:*",
    "@branch/core": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "typescript": "~5.9.3"
  },
  "build": {
    "appId": "app.branchlearn.desktop",
    "productName": "rhymebook",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "!dist/**/*.map",
      "package.json"
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "음성으로 질문하려면 마이크가 필요합니다. 녹음은 이 PC에서만 글자로 바꿉니다."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "executableName": "rhymebook",
      "category": "Education",
      "maintainer": "rhymebook"
    },
    "deb": {
      "packageName": "rhymebook",
      "artifactName": "rhymebook_${version}_${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "vendor/whisper/${os}-${arch}",
        "to": "whisper",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "author": "rhymebook",
  "homepage": "https://github.com/lafin716/rhymebook"
}
