{
  "name": "octobooks",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "pnpm --filter @branch/ui dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "bridge": "pnpm --filter @branch/bridge build && node packages/bridge/dist/cli.cjs",
    "relay": "pnpm --filter @branch/relay build && node packages/relay/dist/cli.cjs",
    "rhymebook": "pnpm --filter @branch/server build && node packages/server/dist/rhymebook.cjs",
    "e2e": "playwright test",
    "octobooks": "pnpm --filter @branch/server build && node packages/server/dist/rhymebook.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
