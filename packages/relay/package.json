{
  "name": "@branch/relay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/cli.cjs --banner:js=\"#!/usr/bin/env node\"",
    "start": "node dist/cli.cjs"
  },
  "dependencies": {
    "@branch/core": "workspace:*",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@branch/bridge": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  },
  "bin": {
    "branch-relay": "dist/cli.cjs"
  }
}
